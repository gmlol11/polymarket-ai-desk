# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://polymarket_user:polymarket_password@localhost:5433/polymarket_ai_desk

# Redis (matches docker-compose.yml defaults)
REDIS_URL=redis://localhost:6380/0

# LLM API keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# LLM model overrides (optional)
ANTHROPIC_MODEL=
OPENAI_MODEL=

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Experiment runner (all optional — safe defaults shown)
EXPERIMENT_SYNC_LIMIT=500
EXPERIMENT_MARKET_LIMIT=25
EXPERIMENT_REANALYZE_COOLDOWN_HOURS=48
# Skip markets resolving within this many days (live/imminent events). 0 disables.
EXPERIMENT_MIN_DAYS_TO_RESOLUTION=3

# Paper trading stake per BET decision (USD, no real funds used)
PAPER_TRADE_STAKE_USD=1.0

# BET decision thresholds
BET_MIN_EDGE=0.05
BET_MIN_CONFIDENCE=0.65
# Edges above this are flagged (NEEDS_MORE_RESEARCH) instead of auto-bet —
# they are almost always model blind spots, not real market inefficiency.
BET_MAX_EDGE=0.25
